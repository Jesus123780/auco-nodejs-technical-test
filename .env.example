# Solo para iniciar Node.js fuera de Docker. Para el modo todo Docker, no necesitas .env.
# Para esta modalidad opcional, publica MongoDB como "127.0.0.1:27018:27017" en docker-compose.yml.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27018/auco_validations
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DYNAMODB_TABLE=validation_audit
AWS_REGION=us-east-1
# Credenciales ficticias, exclusivamente para DynamoDB Local.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
COUNTRY_API_BASE_URL=https://countries.dev
COUNTRY_API_TIMEOUT_MS=4000
